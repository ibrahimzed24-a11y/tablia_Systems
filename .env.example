# Tablia Systems: environment variable NAMES only. Never commit real values.
# Copy the app part to apps/web/.env.local. Function secrets are set in Supabase, never here.

# --- apps/web (public, shipped to the browser; protected by row level security) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Root domain for restaurant pages, for example tablia.app makes <slug>.tablia.app the public page. /t/<slug> always works.
VITE_TENANT_ROOT_DOMAIN=
# Optional telemetry. Leave empty to switch it off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_LOGROCKET_APP_ID=

# --- Supabase edge function secrets (supabase secrets set NAME=value), used by paymob-checkout and paymob-webhook ---
# PAYMOB_HMAC_SECRET
# PAYMOB_INTEGRATION_ID
# PAYMOB_PUBLIC_KEY
# PAYMOB_REDIRECT_URL
# PAYMOB_SECRET_KEY
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase into functions automatically.

# --- GitHub Actions secrets (repo Settings > Secrets and variables > Actions) ---
# Build: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# Web deploy (manual): VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# Database and functions deploy (manual): SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD
