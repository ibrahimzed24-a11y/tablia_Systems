# Mela Rossa admin: environment variable NAMES only. Never commit real values.
# Copy the app part to apps/staff-pwa/.env.local and the function part to supabase/functions/.env

# --- apps/staff-pwa (public, shipped to the browser; protected by RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Defaults to $VITE_SUPABASE_URL/functions/v1/verify-provision-qr
VITE_PROVISION_FUNCTION_URL=
# Optional telemetry. Leave empty to switch telemetry off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_LOGROCKET_APP_ID=

# --- supabase/functions (set with: supabase secrets set NAME=value) ---
# 32+ random bytes, for example from: openssl rand -base64 48
PROVISION_JWT_SECRET=
# Comma separated, exact origins, for example https://staff.example.com,http://localhost:5173
ALLOWED_ORIGINS=
# Optional, domain used for internal staff login emails
STAFF_EMAIL_DOMAIN=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase into functions automatically.

# --- GitHub Actions secrets (repo Settings > Secrets and variables > Actions) ---
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# Optional: SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD
