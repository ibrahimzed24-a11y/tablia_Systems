# Tablia Systems admin: environment variable NAMES only. Never commit real values.
# Copy the app part to apps/web/.env.local and the function part to supabase/functions/.env

# --- apps/web (public, shipped to the browser; protected by RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Defaults to $VITE_SUPABASE_URL/functions/v1/verify-provision-qr
# Optional. Defaults to $VITE_SUPABASE_URL/functions/v1/export-branch-analytics
# Optional telemetry. Leave empty to switch telemetry off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_LOGROCKET_APP_ID=
# Optional. Root domain of tenant subdomains, for example tablia.app makes mela-rossa.tablia.app the public page. /t/<slug> also works.
VITE_TENANT_ROOT_DOMAIN=

# --- supabase/functions (set with: supabase secrets set NAME=value) ---
# 32+ random bytes, for example from: openssl rand -base64 48
# Comma separated, exact origins (used by verify-provision-qr and export-branch-analytics), for example https://staff.example.com,http://localhost:5173
# Optional, domain used for internal staff login emails
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase into functions automatically.
# export-branch-analytics uses only SUPABASE_URL, SUPABASE_ANON_KEY and the caller's JWT (no service role key).

# --- supabase/functions/provision-domain (server side only: never VITE_ or NEXT_PUBLIC_) ---
# Vercel access token with access to the staff app project, the project id, and the team id (empty for a personal account)
VERCEL_PROJECT_ID=
# Optional: Cloudflare API token (Zone > DNS > Edit, this zone only) and the zone id. Leave empty to add the CNAME by hand.
# provision-domain also uses the injected SUPABASE_SERVICE_ROLE_KEY, only after it has checked that the caller is an admin.

# --- GitHub Actions secrets (repo Settings > Secrets and variables > Actions) ---
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# Optional: SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD
